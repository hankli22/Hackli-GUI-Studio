{
  "schemaVersion": 1,
  "id": "hackli-gui-studio",
  "version": "${version}",
  "name": "Hackli GUI Studio",
  "description": "A GPLv3 visual GUI designer for Meteor Client plugins. Design screens with drag & drop widgets, export Java code with backend callbacks, and let players rearrange layouts live in-game.",
  "authors": [
    "hankli22"
  ],
  "contact": {
    "sources": "https://github.com/hankli22/hackli-gui-studio"
  },
  "icon": "assets/hackli-gui-studio/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.hackli.guidesigner.HackliGuiDesigner"
    ]
  },
  "mixins": [
    "hackli-gui-studio.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "0,180,140",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
